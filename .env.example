# Claude API key for AI face monitoring (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=
# Seconds between AI proctor snapshots per candidate
PROCTOR_INTERVAL_SECONDS=20
# Required on public deployments: passcode for /ops, /report and the AI/backup endpoints
OFFICER_PASSCODE=
# Hard cap on Claude calls per day (proctor + co-pilot + risk report)
AI_DAILY_LIMIT=1500
